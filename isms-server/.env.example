# Entwicklung (HTTP, unsicheres JWT erlaubt)
ENV=development
DATABASE_URL=postgres://ismsserver:ismsserver@localhost:5432/isms?sslmode=disable
HTTP_ADDR=:8080

# Pflicht in Produktion: mindestens 32 Zeichen, zufällig generieren
# Beispiel: openssl rand -base64 48
JWT_SECRET=dev-local-jwt-secret-change-in-production

# Token-Gültigkeit (z. B. 8h, 30m, 24h)
JWT_TTL=8h

# Optional: HTTPS (empfohlen außerhalb der lokalen Entwicklung)
# TLS_CERT_FILE=certs/server.crt
# TLS_KEY_FILE=certs/server.key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_DISPLAY_NAME=Administrator

# Optionale Desktop-Installer (Qt-GUI und Delphi-Client), nicht in der Binary.
# Standard: Ordner "downloads" im Arbeitsverzeichnis (/opt/isms/downloads bzw. %ProgramData%\ISMS\downloads).
# Ordner leer lassen, wenn der Download nicht angeboten werden soll.
# DOWNLOADS_DIR=/opt/isms/downloads

# IT-Grundschutz-Katalog: automatischer Import beim ersten Start, wenn DB leer ist.
# CATALOG_VERSION=2023
# CATALOG_XML_PATH=D:\RADStudio\Delphi\BSI\xml\XML_Kompendium_2023.xml

# Optional: Mitteilungen per E-Mail bei Laufzettel-Wechsel (Inbox gibt es immer).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=isms@example.com
# Öffentliche HTTPS-Adresse (Links in Mails, kanonische URL, Sitemap):
# MAIL_PUBLIC_URL=https://isms.example.com
# Hinter einem Pfad-Prefix inklusive Pfad, z. B. https://example.com/isms

# Impressum (§ 5 DDG), Pflicht sobald die Website öffentlich erreichbar ist.
# Ohne Name, Straße, PLZ, Ort und E-Mail bleibt /impressum unvollständig.
# IMPRESSUM_NAME=Beispiel GmbH
# IMPRESSUM_STREET=Musterstraße 1
# IMPRESSUM_POSTAL_CODE=10115
# IMPRESSUM_CITY=Berlin
# IMPRESSUM_COUNTRY=Deutschland
# IMPRESSUM_EMAIL=kontakt@example.com
# IMPRESSUM_PHONE=+49 30 123456
# IMPRESSUM_REPRESENTATIVE=Ada Beispiel
# IMPRESSUM_REGISTER=Amtsgericht Berlin, HRB 12345
# IMPRESSUM_VAT_ID=DE123456789
# Verantwortlich für journalistisch-redaktionelle Inhalte (§ 18 MStV):
# IMPRESSUM_RESPONSIBLE=Ada Beispiel, Musterstraße 1, 10115 Berlin

# nginx, zwei Varianten (siehe deploy/):
#   Subdomain: deploy/nginx-isms.conf          — WEB_PUBLIC_BASE leer
#   Prefix:    deploy/nginx-prefix.conf        — WEB_PUBLIC_BASE=/isms
# Nur dann X-Forwarded-For / X-Forwarded-Proto vertrauen, wenn der Proxy hier steht:
# TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8

# Produktion hinter nginx-Subdomain (siehe deploy/nginx-isms.conf):
# ENV=production
# HTTP_ADDR=127.0.0.1:8098
# JWT_SECRET=<mind. 32 Zeichen, zufällig>
# JWT_TTL=8h
# TRUSTED_PROXIES=127.0.0.1,::1
# ADMIN_PASSWORD=<nicht changeme>
#
# TLS terminiert nginx (Certbot). Kein TLS_CERT_FILE am Go-Prozess nötig.
# Eigenes Zertifikat am Go-Prozess statt nginx:
# TLS_CERT_FILE=/etc/isms/server.crt
# TLS_KEY_FILE=/etc/isms/server.key
