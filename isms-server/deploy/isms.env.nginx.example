# Produktion hinter Host-nginx + DuckDNS (Certbot).
# Nach /etc/isms/isms.env kopieren und Secrets setzen.
#
# nginx: deploy/nginx-isms.conf
# Certbot: sudo certbot --nginx -d isms.duckdns.org

ENV=production
HTTP_ADDR=127.0.0.1:8098
DATABASE_URL=postgres://ismsserver:ismsserver@localhost:5432/isms?sslmode=disable

# openssl rand -base64 48
JWT_SECRET=
JWT_TTL=8h

TRUSTED_PROXIES=127.0.0.1,::1

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# CATALOG_XML_PATH=/opt/isms/catalog/XML_Kompendium_2023.xml
