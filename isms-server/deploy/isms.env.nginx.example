# Produktion hinter nginx auf einer eigenen Subdomain (deploy/nginx-isms.conf).
# Nach /etc/isms/isms.env kopieren und Secrets setzen.
# WEB_PUBLIC_BASE bleibt leer.
#
# Oder: sudo isms-setup-nginx subdomain isms.example.com
# Certbot: sudo certbot --nginx -d isms.example.com
#
# Pfad-Prefix auf einem bestehenden vHost: deploy/isms.env.nginx-prefix.example

ENV=production
HTTP_ADDR=127.0.0.1:8098
DATABASE_URL=postgres://ismsserver:ismsserver@localhost:5432/isms?sslmode=disable

# openssl rand -base64 48
JWT_SECRET=
JWT_TTL=8h

TRUSTED_PROXIES=127.0.0.1,::1

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# CATALOG_XML_PATH=/opt/isms/catalog/XML_Kompendium_2023.xml

# Öffentliche HTTPS-Adresse für Mails, kanonische URL und Sitemap.
# MAIL_PUBLIC_URL=https://isms.example.com

# Client-Installer (Qt-GUI, Delphi) liegen in diesem Ordner, nicht in der Binary.
# Leer lassen = kein Download in der Web-UI. Austausch ohne Neustart, siehe README.
# DOWNLOADS_DIR=/opt/isms/downloads
